DATABASE_URL=postgresql+psycopg://risk_user:risk_password@127.0.0.1:5432/risk_platform
AUTO_CREATE_SCHEMA=false
APP_ENV=production
AUTH_MODE=oidc
OIDC_ISSUER=http://127.0.0.1:8080/realms/risk-platform
OIDC_AUDIENCE=risk-platform-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/risk-platform/protocol/openid-connect/certs

# Local development storage. Set STORAGE_BACKEND=s3 for MinIO/S3.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads
# auto: macOS 使用本机 Vision 离线 OCR；false: 禁用并降级为人工核验。
OCR_ENABLED=auto
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=risk-documents
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=change-me
